generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Módulo ESM, compatible con Node ejecutando TypeScript directamente.
  moduleFormat           = "esm"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Configuración global del sitio. Un único registro (id = "global").
model SiteSettings {
  id                    String   @id @default("global")
  /// Solo dígitos, con código de país (ej. 549XXXXXXXXXX). null = sin configurar.
  whatsappNumber        String?  @map("whatsapp_number") @db.VarChar(15)
  /// Usuario de Instagram con @ (ej. @sweet.cookies.rio4). null = no mostrar.
  instagramHandle       String?  @map("instagram_handle") @db.VarChar(31)
  whatsappOrdersEnabled Boolean  @default(true) @map("whatsapp_orders_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  /// Id de Clerk del último admin que modificó la configuración (auditoría mínima).
  updatedBy             String?  @map("updated_by") @db.VarChar(64)

  @@map("site_settings")
}
