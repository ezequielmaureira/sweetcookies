generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Módulo ESM, compatible con Node ejecutando TypeScript directamente.
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Configuración global del sitio. Un único registro (id = "global").
/// `whatsappNumber` es el teléfono del negocio para pedidos (WhatsApp).
model SiteSettings {
  id                    String   @id @default("global")
  /// Solo dígitos, con código de país (ej. 549XXXXXXXXXX). null = sin configurar.
  whatsappNumber        String?  @map("whatsapp_number") @db.VarChar(15)
  /// Usuario de Instagram con @ (ej. @sweet.cookies.rio4). null = no mostrar.
  instagramHandle       String?  @map("instagram_handle") @db.VarChar(31)
  /// Interruptor maestro "Pedidos activos": false = se ve el catálogo pero no se aceptan pedidos nuevos.
  ordersEnabled         Boolean  @default(true) @map("orders_enabled")
  /// Mensaje opcional para el comprador cuando los pedidos están pausados (ej. vacaciones).
  ordersDisabledMessage String?  @map("orders_disabled_message") @db.VarChar(200)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  /// Id de Clerk del último admin que modificó la configuración (auditoría mínima).
  updatedBy             String?  @map("updated_by") @db.VarChar(64)

  @@map("site_settings")
}

enum ProductStatus {
  ACTIVE
  PAUSED
}

/// COOKIE: se puede elegir para armar el box. OTHER: budín, torta, brownie…
/// se compra suelto y NUNCA ocupa lugar en el box.
enum ProductKind {
  COOKIE
  OTHER
}

/// Catálogo único: lo administra el panel y lo consume la web pública.
/// "Sin stock" no se guarda: es ACTIVE con stock = 0 (estado calculado).
model Product {
  id               String        @id @default(cuid()) @db.VarChar(40)
  name             String        @db.VarChar(80)
  description      String?       @db.VarChar(400)
  /// Precio de venta (ARS). Nunca Float: Decimal exacto.
  price            Decimal       @db.Decimal(12, 2)
  /// Costo unitario (ARS). Solo lo ve el admin.
  cost             Decimal       @db.Decimal(12, 2)
  stock            Int           @default(0)
  /// Foto principal (catálogo, cards). Ruta local (/images/...), imagen subida
  /// (/api/public/images/<id>) o URL https.
  imageUrl         String?       @map("image_url") @db.VarChar(500)
  /// Encuadre de la foto principal (catálogo): zoom 1–4 y punto central 0–100 %.
  imageScale       Float         @default(1) @map("image_scale")
  imageX           Float         @default(50) @map("image_x")
  imageY           Float         @default(50) @map("image_y")
  /// Imagen OPCIONAL solo para la caja. Si existe, la caja usa esta; si no,
  /// usa imageUrl encuadrada con los parámetros box_image_*.
  boxImageUrl      String?       @map("box_image_url") @db.VarChar(500)
  /// Zoom del encuadre en la caja (1 = sin zoom, hasta 4).
  boxImageScale    Float         @default(1) @map("box_image_scale")
  /// Punto de la foto que queda al centro de la cookie (0–100 %).
  boxImageX        Float         @default(50) @map("box_image_x")
  boxImageY        Float         @default(50) @map("box_image_y")
  /// Rotación del encuadre, en grados (−180 a 180).
  boxImageRotation Int           @default(0) @map("box_image_rotation")
  category         String?       @db.VarChar(40)
  /// Cookie (va en el box) u otro producto (se compra suelto).
  kind             ProductKind   @default(COOKIE)
  status           ProductStatus @default(ACTIVE)
  featured         Boolean       @default(false)
  /// Orden del catálogo (después de los destacados).
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  orderItems OrderItem[]
  /// Receta vinculada (Gestión). Todavía sin uso: preparado para costo/margen por producto.
  recipe     Recipe?

  @@index([status, featured, sortOrder])
  @@map("products")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

/// Pedido confirmado por el comprador. Totales calculados en el servidor.
model Order {
  id               String         @id @default(cuid()) @db.VarChar(40)
  /// Número visible para el cliente y el admin (ej. #1001).
  number           Int            @unique @default(autoincrement())
  customerName     String         @map("customer_name") @db.VarChar(80)
  customerLastName String?        @map("customer_last_name") @db.VarChar(80)
  /// Solo dígitos (se normaliza al guardar): permite buscar sin importar el formato.
  customerPhone    String?        @map("customer_phone") @db.VarChar(20)
  customerEmail    String?        @map("customer_email") @db.VarChar(120)
  /// Nombre + apellido en minúsculas: orden A-Z sin depender de mayúsculas.
  customerSortKey  String         @map("customer_sort_key") @db.VarChar(170)
  deliveryMethod   DeliveryMethod @map("delivery_method")
  deliveryAddress  String?        @map("delivery_address") @db.VarChar(200)
  notes            String?        @db.VarChar(600)
  /// Suma de los subtotales de los items.
  total            Decimal        @db.Decimal(12, 2)
  /// Suma de las ganancias de los items. Solo la ve el admin.
  profit           Decimal        @db.Decimal(12, 2)
  itemCount        Int            @map("item_count")
  status           OrderStatus    @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([createdAt])
  @@index([total])
  @@index([profit])
  @@index([customerSortKey])
  @@map("orders")
}

/// Línea de un pedido con los valores HISTÓRICOS del momento de la compra.
/// Nunca se recalcula con el precio/costo actual del producto.
model OrderItem {
  id                  String      @id @default(cuid()) @db.VarChar(40)
  orderId             String      @map("order_id") @db.VarChar(40)
  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// null si el producto se eliminó después: el snapshot conserva el historial.
  productId           String?     @map("product_id") @db.VarChar(40)
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String      @map("product_name_snapshot") @db.VarChar(80)
  /// Tipo del producto al momento de la compra (los pedidos anteriores quedan como COOKIE).
  productKind         ProductKind @default(COOKIE) @map("product_kind")
  quantity            Int
  unitPrice           Decimal     @map("unit_price") @db.Decimal(12, 2)
  unitCost            Decimal     @map("unit_cost") @db.Decimal(12, 2)
  /// unitPrice × quantity
  subtotal            Decimal     @db.Decimal(12, 2)
  /// (unitPrice − unitCost) × quantity
  profit              Decimal     @db.Decimal(12, 2)
  createdAt           DateTime    @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Imágenes subidas desde el panel (fotos de producto y de caja). Se guardan en
/// la base (son chicas: el navegador las reduce antes de subir) y se sirven
/// desde GET /api/public/images/:id con caché inmutable.
model ProductImage {
  id          String   @id @default(cuid()) @db.VarChar(40)
  contentType String   @map("content_type") @db.VarChar(20)
  data        Bytes
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now()) @map("created_at")
  /// Id de Clerk del admin que la subió.
  createdBy   String?  @map("created_by") @db.VarChar(64)

  @@map("product_images")
}

/// Estado guardado del voucher. "Vencido" NO se guarda: es ACTIVE con
/// expiresAt < ahora (se calcula al leer).
enum VoucherStatus {
  ACTIVE
  REDEEMED
  CANCELLED
}

/// Voucher de regalo (caja de 4 o 6 cookies) con QR único.
/// El QR apunta a /v/<publicId>; el canje es un UPDATE condicional atómico
/// (nunca se puede canjear dos veces). Los registros no se borran.
model Voucher {
  id                String        @id @default(cuid()) @db.VarChar(40)
  /// Identificador público del QR (aleatorio, no adivinable).
  publicId          String        @unique @map("public_id") @db.VarChar(32)
  /// Código corto visible (ej. SC-8K4P2M).
  code              String        @unique @db.VarChar(16)
  /// Texto que se muestra en el voucher (ej. "Premio sorteo aniversario").
  /// null = "Premio donado por Sweet Cookies".
  description       String?       @db.VarChar(120)
  /// 4 o 6 (CHECK en la base).
  cookieQuantity    Int           @map("cookie_quantity")
  /// Último instante válido para canjear (fin del día elegido, hora Argentina).
  expiresAt         DateTime      @map("expires_at")
  status            VoucherStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  /// Id de Clerk del admin que lo creó.
  createdByUserId   String?       @map("created_by_user_id") @db.VarChar(64)
  redeemedAt        DateTime?     @map("redeemed_at")
  /// Id de Clerk del admin que lo canjeó.
  redeemedByUserId  String?       @map("redeemed_by_user_id") @db.VarChar(64)
  cancelledAt       DateTime?     @map("cancelled_at")
  /// Id de Clerk del admin que lo anuló.
  cancelledByUserId String?       @map("cancelled_by_user_id") @db.VarChar(64)

  @@index([createdAt])
  @@index([status, expiresAt])
  @@map("vouchers")
}

/// Textos públicos editables desde el panel (Configuración → Textos del sitio).
/// Genérico: una fila por texto, identificada por `key` (ej. HOME_TITLE).
/// Sin fila = la web muestra el texto original (fallback en el código).
model SiteContent {
  id              String   @id @default(cuid()) @db.VarChar(40)
  /// Clave interna (nunca se muestra al admin).
  key             String   @unique @db.VarChar(60)
  value           String   @db.VarChar(400)
  /// Grupo en el panel (ej. "home") y nombre visible del campo (ej. "Título principal").
  section         String   @db.VarChar(40)
  label           String   @db.VarChar(80)
  description     String?  @db.VarChar(200)
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Id de Clerk del admin que lo cambió.
  updatedByUserId String?  @map("updated_by_user_id") @db.VarChar(64)

  @@map("site_content")
}

/**
 * ---------- Gestión: ingredientes, precios y recetas (solo admin) ----------
 */

/// Unidad en la que se calcula cada ingrediente (todo se convierte a esta).
enum IngredientBaseUnit {
  GRAM
  MILLILITER
  UNIT
}

/// Unidad en la que se carga una compra o una cantidad de receta.
/// G/KG → GRAM · ML/L → MILLILITER · UNIT/PACKAGE → UNIT (PACKAGE solo en compras).
enum MeasureUnit {
  G
  KG
  ML
  L
  UNIT
  PACKAGE
}

model Ingredient {
  id           String             @id @default(cuid()) @db.VarChar(40)
  name         String             @db.VarChar(80)
  baseUnit     IngredientBaseUnit @map("base_unit")
  /// Equivalencias opcionales para convertir unidades ↔ peso/volumen (nunca se inventan):
  /// "1 unidad = X g" y/o "1 unidad = X ml". Sin equivalencia no se convierte.
  gramsPerUnit Decimal?           @map("grams_per_unit") @db.Decimal(14, 4)
  mlPerUnit    Decimal?           @map("ml_per_unit") @db.Decimal(14, 4)
  /// Inactivo: sigue en las recetas que ya lo usan, pero no se ofrece para recetas nuevas.
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  /// Historial de compras: nunca se sobrescribe. Costo actual = compra más reciente.
  prices      IngredientPrice[]
  recipeLines RecipeIngredient[]

  @@index([name])
  @@map("ingredients")
}

/// Una compra: lo que se compró, cuánto y cuánto se pagó. El costo por unidad
/// base se calcula al guardar (y queda fijo para ese registro).
model IngredientPrice {
  id               String      @id @default(cuid()) @db.VarChar(40)
  ingredientId     String      @map("ingredient_id") @db.VarChar(40)
  ingredient       Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchaseQuantity Decimal     @map("purchase_quantity") @db.Decimal(14, 4)
  purchaseUnit     MeasureUnit @map("purchase_unit")
  /// Solo para PACKAGE: unidades por paquete.
  unitsPerPackage  Decimal?    @map("units_per_package") @db.Decimal(14, 4)
  /// Cantidad comprada en la unidad base del ingrediente (g, ml o unidades).
  baseQuantity     Decimal     @map("base_quantity") @db.Decimal(18, 4)
  totalPrice       Decimal     @map("total_price") @db.Decimal(14, 2)
  /// totalPrice / baseQuantity, con precisión alta (ej. 29,3213333333 $/g).
  unitCost         Decimal     @map("unit_cost") @db.Decimal(20, 10)
  supplierName     String?     @map("supplier_name") @db.VarChar(80)
  purchasedAt      DateTime    @map("purchased_at") @db.Date
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([ingredientId, purchasedAt(sort: Desc), createdAt(sort: Desc)])
  @@map("ingredient_prices")
}

/// Borrador: faltan datos (rellenos, cantidades, rendimiento). Completa: receta terminada.
enum RecipeStatus {
  DRAFT
  COMPLETE
}

/// Receta: el costo NO se guarda, se calcula siempre con los precios actuales.
model Recipe {
  id            String       @id @default(cuid()) @db.VarChar(40)
  name          String       @db.VarChar(80)
  /// Cantidad de cookies que produce. null solo en borrador (rendimiento pendiente).
  yieldQuantity Int?         @map("yield_quantity")
  status        RecipeStatus @default(COMPLETE)
  /// Lo que falta completar u otras aclaraciones.
  notes         String?      @db.VarChar(1000)
  active        Boolean      @default(true)
  /// Producto vinculado (futuro: costo y margen por producto). Hoy sin uso.
  productId     String?      @unique @map("product_id") @db.VarChar(40)
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  ingredients RecipeIngredient[]
  extraCosts  RecipeExtraCost[]

  @@index([name])
  @@map("recipes")
}

/// Parte de la cookie a la que pertenece un ingrediente de la receta.
/// UNASSIGNED = "Sin clasificar" (para revisar desde el Admin).
enum RecipeComponent {
  UNASSIGNED
  DOUGH
  FILLING
}

model RecipeIngredient {
  id           String          @id @default(cuid()) @db.VarChar(40)
  recipeId     String          @map("recipe_id") @db.VarChar(40)
  recipe       Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Restrict: un ingrediente usado en recetas no se puede borrar (se marca inactivo).
  ingredientId String          @map("ingredient_id") @db.VarChar(40)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(14, 4)
  unit         MeasureUnit
  /// Parte de la receta (masa o relleno). UNASSIGNED = "Sin clasificar".
  component    RecipeComponent @default(UNASSIGNED)
  /// Orden de las líneas en la receta.
  position     Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

/// Gasto adicional libre de la receta (gas, packaging, sticker…).
model RecipeExtraCost {
  id        String   @id @default(cuid()) @db.VarChar(40)
  recipeId  String   @map("recipe_id") @db.VarChar(40)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  amount    Decimal  @db.Decimal(14, 2)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([recipeId])
  @@map("recipe_extra_costs")
}

/**
 * ---------- Sweet Click Challenge (campeonato semanal) ----------
 * Módulo independiente: no se relaciona con productos, pedidos ni vouchers.
 */

/// Estado GUARDADO de un torneo. Lo pone el admin: DRAFT (borrador, nunca
/// visible), SCHEDULED (publicado), UNPUBLISHED (despublicado: oculto, conserva
/// sus datos), PAUSED, FINISHED (finalizado a mano), RESULTS_PUBLISHED y
/// CANCELLED (histórico). Con un torneo publicado, PROGRAMADO / ACTIVO /
/// FINALIZADO se CALCULAN con la hora del servidor y sus fechas (ver
/// api/src/challenge-time.ts → effectiveStatus). ACTIVE guardado = publicado
/// (torneos anteriores a este cambio).
enum ChallengeStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  FINISHED
  RESULTS_PUBLISHED
  DRAFT
  CANCELLED
  UNPUBLISHED
}

/// Torneo (tabla histórica "challenge_editions"). Lo crea y programa el admin
/// con fechas, premio e intentos propios; no hay calendario fijo ni creación
/// automática. Se activa y finaliza solo según sus fechas (hora del servidor).
/// Los torneos de PRUEBA y los oficiales nunca se mezclan: cada uno tiene su
/// numeración, su ranking y sus resultados. Nunca se superponen dos torneos
/// publicados.
model ChallengeEdition {
  id                  String          @id @default(cuid()) @db.VarChar(40)
  /// true = torneo HISTÓRICO de prueba (anterior a los torneos reales): nunca genera
  /// premios ni reclamos y no bloquea fechas. Todos los torneos nuevos son reales (false).
  isTest              Boolean         @default(false) @map("is_test")
  /// Número interno, independiente para prueba y oficial.
  number              Int
  name                String          @db.VarChar(80)
  description         String?         @db.VarChar(500)
  /// Solo de las ediciones semanales anteriores (YYYY-MM-DD). null en los torneos nuevos.
  weekStart           String?         @map("week_start") @db.VarChar(10)
  startsAt            DateTime        @map("starts_at")
  endsAt              DateTime        @map("ends_at")
  status              ChallengeStatus @default(DRAFT)
  /// Reglas copiadas al crear el torneo (un cambio de código no altera un torneo en curso).
  gameDurationMs      Int             @default(15000) @map("game_duration_ms")
  /// Intentos oficiales por participante en TODO el torneo (los define el admin).
  attempts            Int             @default(3)
  /// Premio del primer puesto (lo define el admin).
  prize               String          @db.VarChar(120)
  prizeDescription    String?         @map("prize_description") @db.VarChar(500)
  /// Foto del premio (opcional): ruta de una imagen subida desde el panel
  /// (/api/public/images/<id>, mismo sistema que las fotos de productos).
  prizeImageUrl       String?         @map("prize_image_url") @db.VarChar(100)
  createdBy           String?         @map("created_by") @db.VarChar(64)
  cancelledAt         DateTime?       @map("cancelled_at")
  cancelledBy         String?         @map("cancelled_by") @db.VarChar(64)
  cancelReason        String?         @map("cancel_reason") @db.VarChar(300)
  /// Eliminación lógica (torneos con actividad): sale del listado y de la página, no
  /// bloquea fechas ni acepta partidas o reclamos, pero conserva su historial.
  deletedAt           DateTime?       @map("deleted_at")
  deletedBy           String?         @map("deleted_by") @db.VarChar(64)
  deleteReason        String?         @map("delete_reason") @db.VarChar(300)
  pausedAt            DateTime?       @map("paused_at")
  pausedBy            String?         @map("paused_by") @db.VarChar(64)
  pauseReason         String?         @map("pause_reason") @db.VarChar(300)
  /// Ganador confirmado por el admin al publicar resultados (nunca automático).
  winnerParticipantId String?         @map("winner_participant_id") @db.VarChar(40)
  winnerGameId        String?         @map("winner_game_id") @db.VarChar(40)
  winnerScore         Int?            @map("winner_score")
  resultsPublishedAt  DateTime?       @map("results_published_at")
  resultsPublishedBy  String?         @map("results_published_by") @db.VarChar(64)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  games             ChallengeGame[]
  disqualifications ChallengeDisqualification[]
  actions           ChallengeAdminAction[]
  claim             ChallengePrizeClaim?
  invites           ChallengeInvite[]
  referrals         ChallengeReferral[]

  @@unique([isTest, number])
  @@index([startsAt])
  @@index([status, startsAt])
  @@index([deletedAt])
  @@map("challenge_editions")
}

/// Participante: solo su @ de Instagram (sin contraseña). Se lo reconoce por
/// un token aleatorio que solo tiene su navegador; acá se guarda únicamente su
/// hash SHA-256. El @ no prueba identidad: es un dato declarado.
model ChallengeParticipant {
  id                  String    @id @default(cuid()) @db.VarChar(40)
  /// Usuario de Instagram en minúsculas, sin @. Único: el mismo @ no obtiene otra sesión (ni otros intentos) desde otro navegador.
  instagram           String    @unique @db.VarChar(30)
  termsAcceptedAt     DateTime  @map("terms_accepted_at")
  termsVersion        String    @map("terms_version") @db.VarChar(30)
  tokenHash           String    @unique @map("token_hash") @db.VarChar(64)
  tokenIssuedAt       DateTime  @map("token_issued_at")
  /// HMAC-SHA256 de la IP al registrarse (nunca la IP en texto plano). null = sin clave configurada.
  ipHash              String?   @map("ip_hash") @db.VarChar(64)
  /// Veces que alguien intentó registrar este mismo @ desde otro navegador (alerta para el admin).
  duplicateAttempts   Int       @default(0) @map("duplicate_attempts")
  lastDuplicateAt     DateTime? @map("last_duplicate_at")
  /// Recuperación manual: código de un solo uso que genera el admin (solo su hash).
  recoveryCodeHash    String?   @map("recovery_code_hash") @db.VarChar(64)
  recoveryExpiresAt   DateTime? @map("recovery_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  /// Nombre y apellido y WhatsApp que deja el participante antes de jugar, solo
  /// para gestionar el campeonato y contactarlo si gana. NUNCA públicos: solo
  /// los ve el panel (y el teléfono, solo en los datos del ganador).
  /// null = participante anterior a este requisito (se le piden antes de jugar).
  fullName            String?   @map("full_name") @db.VarChar(60)
  /// WhatsApp en formato internacional, solo dígitos (Argentina: 549 + 10 dígitos).
  phone               String?   @db.VarChar(16)
  contactUpdatedAt    DateTime? @map("contact_updated_at")
  /// Versión de las bases aceptada al dejar (o actualizar) los datos de contacto.
  contactTermsVersion String?   @map("contact_terms_version") @db.VarChar(30)

  games             ChallengeGame[]
  disqualifications ChallengeDisqualification[]
  claims            ChallengePrizeClaim[]
  invites           ChallengeInvite[]
  referralsMade     ChallengeReferral[]         @relation("referrer")
  referredBy        ChallengeReferral[]         @relation("referred")

  @@index([ipHash])
  /// Para avisar al admin si un mismo WhatsApp aparece en varios @ (no bloquea).
  @@index([phone])
  @@map("challenge_participants")
}

enum ChallengeGameStatus {
  /// Intento reservado: consume uno de los intentos del torneo aunque se abandone.
  STARTED
  FINISHED
  /// No se cerró a tiempo: intento usado, sin puntaje.
  EXPIRED
}

enum ChallengeSuspicion {
  NONE
  LOW
  HIGH
}

enum ChallengeReview {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// Una partida oficial = un intento. Nunca se borra. El puntaje lo calcula el
/// servidor a partir de los toques; nunca se acepta un total enviado por el
/// navegador. Las partidas de práctica no llegan al servidor.
model ChallengeGame {
  id              String               @id @default(cuid()) @db.VarChar(40)
  editionId       String               @map("edition_id") @db.VarChar(40)
  edition         ChallengeEdition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  participantId   String               @map("participant_id") @db.VarChar(40)
  participant     ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  /// Número de intento dentro del torneo (1..attempts).
  attemptNumber   Int                  @map("attempt_number")
  status          ChallengeGameStatus  @default(STARTED)
  /// Hora del SERVIDOR.
  startedAt       DateTime             @map("started_at")
  finishedAt      DateTime?            @map("finished_at")
  /// HMAC-SHA256 de la IP al reservar el intento (posibles duplicados; nunca bloquea solo).
  ipHash          String?              @map("ip_hash") @db.VarChar(64)
  score           Int?
  cookies         Int?
  tapsReceived    Int?                 @map("taps_received")
  tapsIgnored     Int?                 @map("taps_ignored")
  untrustedTaps   Int?                 @map("untrusted_taps")
  /// Toques recibidos, planos: [t, x, y, t, x, y, …] (ms desde el "¡YA!", posición 0–100).
  taps            Int[]
  /// Señales de sospecha (solas no descalifican).
  flags           String[]
  suspicion       ChallengeSuspicion   @default(NONE)
  review          ChallengeReview      @default(NONE)
  reviewedAt      DateTime?            @map("reviewed_at")
  reviewedBy      String?              @map("reviewed_by") @db.VarChar(64)
  reviewReason    String?              @map("review_reason") @db.VarChar(300)
  /// Id aleatorio que manda el navegador al tocar "Jugar": un reintento o doble toque devuelve la MISMA partida (no consume otro intento).
  clientRequestId String?              @map("client_request_id") @db.VarChar(40)

  /// Dos pestañas o pedidos simultáneos nunca toman el mismo intento del torneo.
  @@unique([participantId, editionId, attemptNumber])
  @@unique([participantId, clientRequestId])
  @@index([editionId, status, score])
  @@index([editionId, review])
  @@index([editionId, ipHash])
  @@map("challenge_games")
}

/// Descalificación de un participante en una edición (con motivo y autor).
model ChallengeDisqualification {
  id            String               @id @default(cuid()) @db.VarChar(40)
  editionId     String               @map("edition_id") @db.VarChar(40)
  edition       ChallengeEdition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  participantId String               @map("participant_id") @db.VarChar(40)
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reason        String               @db.VarChar(300)
  createdBy     String               @map("created_by") @db.VarChar(64)
  createdAt     DateTime             @default(now()) @map("created_at")

  @@unique([editionId, participantId])
  @@map("challenge_disqualifications")
}

enum ChallengeClaimStatus {
  /// Ganador confirmado; todavía no dejó sus datos.
  PENDING
  /// Dejó nombre y celular desde su sesión.
  CLAIMED
  CONTACTED
  DELIVERED
}

/// Premio del primer puesto confirmado (uno por torneo). Se crea al publicar
/// resultados. Nombre y celular solo los carga el ganador desde SU sesión, y
/// solo se ven en el panel (nunca públicos).
model ChallengePrizeClaim {
  id            String               @id @default(cuid()) @db.VarChar(40)
  editionId     String               @unique @map("edition_id") @db.VarChar(40)
  edition       ChallengeEdition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  participantId String               @map("participant_id") @db.VarChar(40)
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  gameId        String               @map("game_id") @db.VarChar(40)
  status        ChallengeClaimStatus @default(PENDING)
  name          String?              @db.VarChar(60)
  /// WhatsApp normalizado (549 + 10 dígitos). Nunca público.
  phone         String?              @db.VarChar(16)
  claimedAt     DateTime?            @map("claimed_at")
  contactedAt   DateTime?            @map("contacted_at")
  deliveredAt   DateTime?            @map("delivered_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([participantId])
  @@map("challenge_prize_claims")
}

/// Registro de cada acción administrativa del campeonato (quién, qué, cuándo y por qué).
model ChallengeAdminAction {
  id            String            @id @default(cuid()) @db.VarChar(40)
  editionId     String?           @map("edition_id") @db.VarChar(40)
  edition       ChallengeEdition? @relation(fields: [editionId], references: [id], onDelete: Restrict)
  participantId String?           @map("participant_id") @db.VarChar(40)
  gameId        String?           @map("game_id") @db.VarChar(40)
  action        String            @db.VarChar(40)
  reason        String?           @db.VarChar(300)
  adminUserId   String            @map("admin_user_id") @db.VarChar(64)
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([editionId, createdAt])
  @@map("challenge_admin_actions")
}

/// Enlace personal de invitación de un participante para un torneo
/// (/campeonato?torneo=…&ref=CODIGO). El código es público y aleatorio: no
/// autentica a nadie ni da intentos, puntos ni ventajas. Solo sirve para medir
/// la difusión.
model ChallengeInvite {
  id            String               @id @default(cuid()) @db.VarChar(40)
  editionId     String               @map("edition_id") @db.VarChar(40)
  edition       ChallengeEdition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  participantId String               @map("participant_id") @db.VarChar(40)
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  /// Código público (10 caracteres aleatorios, ~50 bits).
  code          String               @unique @db.VarChar(16)
  /// HMAC de la IP al crear el enlace (para marcar registros desde la misma conexión).
  ipHash        String?              @map("ip_hash") @db.VarChar(64)
  createdAt     DateTime             @default(now()) @map("created_at")

  visits    ChallengeInviteVisit[]
  referrals ChallengeReferral[]

  /// Un enlace por participante y torneo.
  @@unique([editionId, participantId])
  @@map("challenge_invites")
}

/// Visita atribuida a un enlace: una por visitante (id aleatorio del
/// navegador, guardado solo como hash). No es una "invitación enviada": solo
/// prueba que alguien abrió el enlace.
model ChallengeInviteVisit {
  id          String          @id @default(cuid()) @db.VarChar(40)
  inviteId    String          @map("invite_id") @db.VarChar(40)
  invite      ChallengeInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  visitorHash String          @map("visitor_hash") @db.VarChar(64)
  ipHash      String?         @map("ip_hash") @db.VarChar(64)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([inviteId, visitorHash])
  @@index([inviteId, ipHash])
  @@map("challenge_invite_visits")
}

/// Registro nuevo atribuido a un enlace. Lo decide el servidor al crear la
/// identidad (nunca el navegador). Una persona cuenta como referida una sola vez
/// por torneo y nunca de su propio enlace.
model ChallengeReferral {
  id             String               @id @default(cuid()) @db.VarChar(40)
  editionId      String               @map("edition_id") @db.VarChar(40)
  edition        ChallengeEdition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  inviteId       String               @map("invite_id") @db.VarChar(40)
  invite         ChallengeInvite      @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  referrerId     String               @map("referrer_id") @db.VarChar(40)
  referrer       ChallengeParticipant @relation("referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredId     String               @map("referred_id") @db.VarChar(40)
  referred       ChallengeParticipant @relation("referred", fields: [referredId], references: [id], onDelete: Restrict)
  /// Misma conexión que quien invitó (puede ser familia, o la misma persona): se muestra aparte, no se bloquea.
  sameConnection Boolean              @default(false) @map("same_connection")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@unique([editionId, referredId])
  @@index([inviteId])
  @@map("challenge_referrals")
}
