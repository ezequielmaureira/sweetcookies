generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Módulo ESM, compatible con Node ejecutando TypeScript directamente.
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Configuración global del sitio. Un único registro (id = "global").
/// `whatsappNumber` es el teléfono del negocio para pedidos (WhatsApp).
model SiteSettings {
  id                    String   @id @default("global")
  /// Solo dígitos, con código de país (ej. 549XXXXXXXXXX). null = sin configurar.
  whatsappNumber        String?  @map("whatsapp_number") @db.VarChar(15)
  /// Usuario de Instagram con @ (ej. @sweet.cookies.rio4). null = no mostrar.
  instagramHandle       String?  @map("instagram_handle") @db.VarChar(31)
  /// Interruptor maestro "Pedidos activos": false = se ve el catálogo pero no se aceptan pedidos nuevos.
  ordersEnabled         Boolean  @default(true) @map("orders_enabled")
  /// Mensaje opcional para el comprador cuando los pedidos están pausados (ej. vacaciones).
  ordersDisabledMessage String?  @map("orders_disabled_message") @db.VarChar(200)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  /// Id de Clerk del último admin que modificó la configuración (auditoría mínima).
  updatedBy             String?  @map("updated_by") @db.VarChar(64)

  @@map("site_settings")
}

enum ProductStatus {
  ACTIVE
  PAUSED
}

/// Catálogo único: lo administra el panel y lo consume la web pública.
/// "Sin stock" no se guarda: es ACTIVE con stock = 0 (estado calculado).
model Product {
  id               String        @id @default(cuid()) @db.VarChar(40)
  name             String        @db.VarChar(80)
  description      String?       @db.VarChar(400)
  /// Precio de venta (ARS). Nunca Float: Decimal exacto.
  price            Decimal       @db.Decimal(12, 2)
  /// Costo unitario (ARS). Solo lo ve el admin.
  cost             Decimal       @db.Decimal(12, 2)
  stock            Int           @default(0)
  /// Foto principal (catálogo, cards). Ruta local (/images/...), imagen subida
  /// (/api/public/images/<id>) o URL https.
  imageUrl         String?       @map("image_url") @db.VarChar(500)
  /// Imagen OPCIONAL solo para la caja. Si existe, la caja usa esta; si no,
  /// usa imageUrl encuadrada con los parámetros box_image_*.
  boxImageUrl      String?       @map("box_image_url") @db.VarChar(500)
  /// Zoom del encuadre en la caja (1 = sin zoom, hasta 4).
  boxImageScale    Float         @default(1) @map("box_image_scale")
  /// Punto de la foto que queda al centro de la cookie (0–100 %).
  boxImageX        Float         @default(50) @map("box_image_x")
  boxImageY        Float         @default(50) @map("box_image_y")
  /// Rotación del encuadre, en grados (−180 a 180).
  boxImageRotation Int           @default(0) @map("box_image_rotation")
  category         String?       @db.VarChar(40)
  status           ProductStatus @default(ACTIVE)
  featured         Boolean       @default(false)
  /// Orden del catálogo (después de los destacados).
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  orderItems OrderItem[]
  /// Receta vinculada (Gestión). Todavía sin uso: preparado para costo/margen por producto.
  recipe     Recipe?

  @@index([status, featured, sortOrder])
  @@map("products")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

/// Pedido confirmado por el comprador. Totales calculados en el servidor.
model Order {
  id               String         @id @default(cuid()) @db.VarChar(40)
  /// Número visible para el cliente y el admin (ej. #1001).
  number           Int            @unique @default(autoincrement())
  customerName     String         @map("customer_name") @db.VarChar(80)
  customerLastName String?        @map("customer_last_name") @db.VarChar(80)
  /// Solo dígitos (se normaliza al guardar): permite buscar sin importar el formato.
  customerPhone    String?        @map("customer_phone") @db.VarChar(20)
  customerEmail    String?        @map("customer_email") @db.VarChar(120)
  /// Nombre + apellido en minúsculas: orden A-Z sin depender de mayúsculas.
  customerSortKey  String         @map("customer_sort_key") @db.VarChar(170)
  deliveryMethod   DeliveryMethod @map("delivery_method")
  deliveryAddress  String?        @map("delivery_address") @db.VarChar(200)
  notes            String?        @db.VarChar(600)
  /// Suma de los subtotales de los items.
  total            Decimal        @db.Decimal(12, 2)
  /// Suma de las ganancias de los items. Solo la ve el admin.
  profit           Decimal        @db.Decimal(12, 2)
  itemCount        Int            @map("item_count")
  status           OrderStatus    @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([createdAt])
  @@index([total])
  @@index([profit])
  @@index([customerSortKey])
  @@map("orders")
}

/// Línea de un pedido con los valores HISTÓRICOS del momento de la compra.
/// Nunca se recalcula con el precio/costo actual del producto.
model OrderItem {
  id                  String   @id @default(cuid()) @db.VarChar(40)
  orderId             String   @map("order_id") @db.VarChar(40)
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// null si el producto se eliminó después: el snapshot conserva el historial.
  productId           String?  @map("product_id") @db.VarChar(40)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(80)
  quantity            Int
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost            Decimal  @map("unit_cost") @db.Decimal(12, 2)
  /// unitPrice × quantity
  subtotal            Decimal  @db.Decimal(12, 2)
  /// (unitPrice − unitCost) × quantity
  profit              Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Imágenes subidas desde el panel (fotos de producto y de caja). Se guardan en
/// la base (son chicas: el navegador las reduce antes de subir) y se sirven
/// desde GET /api/public/images/:id con caché inmutable.
model ProductImage {
  id          String   @id @default(cuid()) @db.VarChar(40)
  contentType String   @map("content_type") @db.VarChar(20)
  data        Bytes
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now()) @map("created_at")
  /// Id de Clerk del admin que la subió.
  createdBy   String?  @map("created_by") @db.VarChar(64)

  @@map("product_images")
}

/// Estado guardado del voucher. "Vencido" NO se guarda: es ACTIVE con
/// expiresAt < ahora (se calcula al leer).
enum VoucherStatus {
  ACTIVE
  REDEEMED
  CANCELLED
}

/// Voucher de regalo (caja de 4 o 6 cookies) con QR único.
/// El QR apunta a /v/<publicId>; el canje es un UPDATE condicional atómico
/// (nunca se puede canjear dos veces). Los registros no se borran.
model Voucher {
  id                String        @id @default(cuid()) @db.VarChar(40)
  /// Identificador público del QR (aleatorio, no adivinable).
  publicId          String        @unique @map("public_id") @db.VarChar(32)
  /// Código corto visible (ej. SC-8K4P2M).
  code              String        @unique @db.VarChar(16)
  /// Texto que se muestra en el voucher (ej. "Premio sorteo aniversario").
  /// null = "Premio donado por Sweet Cookies".
  description       String?       @db.VarChar(120)
  /// 4 o 6 (CHECK en la base).
  cookieQuantity    Int           @map("cookie_quantity")
  /// Último instante válido para canjear (fin del día elegido, hora Argentina).
  expiresAt         DateTime      @map("expires_at")
  status            VoucherStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  /// Id de Clerk del admin que lo creó.
  createdByUserId   String?       @map("created_by_user_id") @db.VarChar(64)
  redeemedAt        DateTime?     @map("redeemed_at")
  /// Id de Clerk del admin que lo canjeó.
  redeemedByUserId  String?       @map("redeemed_by_user_id") @db.VarChar(64)
  cancelledAt       DateTime?     @map("cancelled_at")
  /// Id de Clerk del admin que lo anuló.
  cancelledByUserId String?       @map("cancelled_by_user_id") @db.VarChar(64)

  @@index([createdAt])
  @@index([status, expiresAt])
  @@map("vouchers")
}

/// Textos públicos editables desde el panel (Configuración → Textos del sitio).
/// Genérico: una fila por texto, identificada por `key` (ej. HOME_TITLE).
/// Sin fila = la web muestra el texto original (fallback en el código).
model SiteContent {
  id              String   @id @default(cuid()) @db.VarChar(40)
  /// Clave interna (nunca se muestra al admin).
  key             String   @unique @db.VarChar(60)
  value           String   @db.VarChar(400)
  /// Grupo en el panel (ej. "home") y nombre visible del campo (ej. "Título principal").
  section         String   @db.VarChar(40)
  label           String   @db.VarChar(80)
  description     String?  @db.VarChar(200)
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Id de Clerk del admin que lo cambió.
  updatedByUserId String?  @map("updated_by_user_id") @db.VarChar(64)

  @@map("site_content")
}

/**
 * ---------- Gestión: ingredientes, precios y recetas (solo admin) ----------
 */

/// Unidad en la que se calcula cada ingrediente (todo se convierte a esta).
enum IngredientBaseUnit {
  GRAM
  MILLILITER
  UNIT
}

/// Unidad en la que se carga una compra o una cantidad de receta.
/// G/KG → GRAM · ML/L → MILLILITER · UNIT/PACKAGE → UNIT (PACKAGE solo en compras).
enum MeasureUnit {
  G
  KG
  ML
  L
  UNIT
  PACKAGE
}

model Ingredient {
  id        String             @id @default(cuid()) @db.VarChar(40)
  name      String             @db.VarChar(80)
  baseUnit  IngredientBaseUnit @map("base_unit")
  /// Inactivo: sigue en las recetas que ya lo usan, pero no se ofrece para recetas nuevas.
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  /// Historial de compras: nunca se sobrescribe. Costo actual = compra más reciente.
  prices      IngredientPrice[]
  recipeLines RecipeIngredient[]

  @@index([name])
  @@map("ingredients")
}

/// Una compra: lo que se compró, cuánto y cuánto se pagó. El costo por unidad
/// base se calcula al guardar (y queda fijo para ese registro).
model IngredientPrice {
  id               String      @id @default(cuid()) @db.VarChar(40)
  ingredientId     String      @map("ingredient_id") @db.VarChar(40)
  ingredient       Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchaseQuantity Decimal     @map("purchase_quantity") @db.Decimal(14, 4)
  purchaseUnit     MeasureUnit @map("purchase_unit")
  /// Solo para PACKAGE: unidades por paquete.
  unitsPerPackage  Decimal?    @map("units_per_package") @db.Decimal(14, 4)
  /// Cantidad comprada en la unidad base del ingrediente (g, ml o unidades).
  baseQuantity     Decimal     @map("base_quantity") @db.Decimal(18, 4)
  totalPrice       Decimal     @map("total_price") @db.Decimal(14, 2)
  /// totalPrice / baseQuantity, con precisión alta (ej. 29,3213333333 $/g).
  unitCost         Decimal     @map("unit_cost") @db.Decimal(20, 10)
  supplierName     String?     @map("supplier_name") @db.VarChar(80)
  purchasedAt      DateTime    @map("purchased_at") @db.Date
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([ingredientId, purchasedAt(sort: Desc), createdAt(sort: Desc)])
  @@map("ingredient_prices")
}

/// Borrador: faltan datos (rellenos, cantidades, rendimiento). Completa: receta terminada.
enum RecipeStatus {
  DRAFT
  COMPLETE
}

/// Receta: el costo NO se guarda, se calcula siempre con los precios actuales.
model Recipe {
  id            String       @id @default(cuid()) @db.VarChar(40)
  name          String       @db.VarChar(80)
  /// Cantidad de cookies que produce. null solo en borrador (rendimiento pendiente).
  yieldQuantity Int?         @map("yield_quantity")
  status        RecipeStatus @default(COMPLETE)
  /// Lo que falta completar u otras aclaraciones.
  notes         String?      @db.VarChar(1000)
  active        Boolean      @default(true)
  /// Producto vinculado (futuro: costo y margen por producto). Hoy sin uso.
  productId     String?      @unique @map("product_id") @db.VarChar(40)
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  ingredients RecipeIngredient[]
  extraCosts  RecipeExtraCost[]

  @@index([name])
  @@map("recipes")
}

/// Parte de la cookie a la que pertenece un ingrediente de la receta.
/// UNASSIGNED = "Sin clasificar" (para revisar desde el Admin).
enum RecipeComponent {
  UNASSIGNED
  DOUGH
  FILLING
}

model RecipeIngredient {
  id           String          @id @default(cuid()) @db.VarChar(40)
  recipeId     String          @map("recipe_id") @db.VarChar(40)
  recipe       Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Restrict: un ingrediente usado en recetas no se puede borrar (se marca inactivo).
  ingredientId String          @map("ingredient_id") @db.VarChar(40)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(14, 4)
  unit         MeasureUnit
  /// Parte de la receta (masa o relleno). UNASSIGNED = "Sin clasificar".
  component    RecipeComponent @default(UNASSIGNED)
  /// Orden de las líneas en la receta.
  position     Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

/// Gasto adicional libre de la receta (gas, packaging, sticker…).
model RecipeExtraCost {
  id        String   @id @default(cuid()) @db.VarChar(40)
  recipeId  String   @map("recipe_id") @db.VarChar(40)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  amount    Decimal  @db.Decimal(14, 2)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([recipeId])
  @@map("recipe_extra_costs")
}
