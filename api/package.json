{
  "name": "sweetcookies-api",
  "private": true,
  "version": "1.0.0",
  "description": "API de Sweet Cookies (Fly.io): configuraci\u00f3n del sitio y panel admin",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@hono/node-server": "^1.19.17",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "hono": "^4.13.9",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  }
}
