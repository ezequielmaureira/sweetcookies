# =====================================================================
# Backend (api/ → Fly.io "sweetcookies-api"). Copiá a api/.env para desarrollo local.
# En Fly se cargan con: fly secrets set NOMBRE=valor --app sweetcookies-api
# NUNCA pongas valores reales en este archivo.
# =====================================================================

PORT=8080

# Neon. Runtime: conexión con pooler. Migraciones: conexión directa.
# Local → rama "dev". Fly (producción) → rama "main".
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk: verifica los tokens de sesión y obtiene los emails verificados del usuario.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Orígenes permitidos (coma) para CORS de /api/admin/* y authorizedParties de Clerk.
# Producción: https://sweetcookies-seven.vercel.app · Local: http://localhost:3000
ALLOWED_ORIGINS=

# Administradores: emails separados por coma (trim + minúsculas). Vacío = nadie es admin.
# Mismo valor que ADMIN_EMAILS en Vercel.
ADMIN_EMAILS=
