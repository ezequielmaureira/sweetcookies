# =====================================================================
# Frontend (Next.js / Vercel). Copiá a .env.local para desarrollo.
# En Vercel se cargan en Project → Settings → Environment Variables.
# NUNCA pongas valores reales en este archivo.
# =====================================================================

# URL pública del backend (Fly.io), sin barra final.
# Producción: https://sweetcookies-api.fly.dev · Local: http://localhost:8080
NEXT_PUBLIC_API_URL=

# Clerk (panel /admin). La publishable key es pública; la secret key es solo server-side.
# Dashboard de Clerk → API keys (o `npx clerk@latest env pull`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Administradores del panel /admin (SOLO server-side: nunca NEXT_PUBLIC_*).
# Emails separados por coma; se comparan en minúsculas contra los emails
# VERIFICADOS del usuario en Clerk. Vacío = nadie puede entrar.
# Debe tener el mismo valor en Vercel y en Fly (api/).
ADMIN_EMAILS=

# El teléfono / WhatsApp de pedidos NO va en variables ni en el código:
# se configura en /admin/configuracion (PostgreSQL → site_settings).

# Base de datos (Neon). El frontend NO la usa: la usa el backend (api/).
# Vercel ya las tiene cargadas (Production → rama "main", Preview/Development → rama "dev").
DATABASE_URL=
DATABASE_URL_UNPOOLED=
